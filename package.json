{
  "name": "hexsleuth",
  "version": "0.1.0",
  "description": "Evidence-backed binary format analysis tools for AI coding agents, with an MCP server and a CLI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "hexsleuth": "dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fixtures": "tsx scripts/generate-fixtures.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "lz4js": "^0.2.0",
    "zod": "^4.6.7"
  }
}
