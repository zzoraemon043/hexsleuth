{
  "id": "zip",
  "title": "ZIP archive without comment",
  "fileExtension": "zip",
  "endian": "le",
  "doc": "Reads the end of central directory record from the end of the file, then the central directory, then each local file through its offset.",
  "instances": {
    "end_of_central_dir": { "pos": "_io.size - 22", "type": "end_of_central_dir" },
    "central_dir": {
      "pos": "end_of_central_dir.central_dir_offset",
      "type": "central_dir_entry",
      "repeat": "expr",
      "repeatExpr": "end_of_central_dir.total_entries"
    }
  },
  "types": {
    "end_of_central_dir": {
      "seq": [
        { "id": "magic", "type": "bytes", "contents": [80, 75, 5, 6] },
        { "id": "disk_number", "type": "u2" },
        { "id": "central_dir_disk", "type": "u2" },
        { "id": "disk_entries", "type": "u2" },
        { "id": "total_entries", "type": "u2" },
        { "id": "central_dir_size", "type": "u4" },
        { "id": "central_dir_offset", "type": "u4" },
        { "id": "comment_length", "type": "u2" },
        { "id": "comment", "type": "bytes", "size": "comment_length" }
      ]
    },
    "central_dir_entry": {
      "seq": [
        { "id": "magic", "type": "bytes", "contents": [80, 75, 1, 2] },
        { "id": "version_made_by", "type": "u2" },
        { "id": "version_needed", "type": "u2" },
        { "id": "flags", "type": "u2" },
        { "id": "method", "type": "u2" },
        { "id": "mod_time", "type": "u2" },
        { "id": "mod_date", "type": "u2" },
        { "id": "crc32", "type": "u4" },
        { "id": "compressed_size", "type": "u4" },
        { "id": "uncompressed_size", "type": "u4" },
        { "id": "name_length", "type": "u2" },
        { "id": "extra_length", "type": "u2" },
        { "id": "comment_length", "type": "u2" },
        { "id": "disk_start", "type": "u2" },
        { "id": "internal_attributes", "type": "u2" },
        { "id": "external_attributes", "type": "u4" },
        { "id": "local_header_offset", "type": "u4" },
        { "id": "name", "type": "str", "size": "name_length", "encoding": "UTF-8" },
        { "id": "extra", "type": "bytes", "size": "extra_length" },
        { "id": "comment", "type": "bytes", "size": "comment_length" }
      ],
      "instances": {
        "local_file": { "pos": "local_header_offset", "type": "local_file" }
      }
    },
    "local_file": {
      "seq": [
        { "id": "magic", "type": "bytes", "contents": [80, 75, 3, 4] },
        { "id": "version_needed", "type": "u2" },
        { "id": "flags", "type": "u2" },
        { "id": "method", "type": "u2" },
        { "id": "mod_time", "type": "u2" },
        { "id": "mod_date", "type": "u2" },
        { "id": "crc32", "type": "u4" },
        { "id": "compressed_size", "type": "u4" },
        { "id": "uncompressed_size", "type": "u4" },
        { "id": "name_length", "type": "u2" },
        { "id": "extra_length", "type": "u2" },
        { "id": "name", "type": "str", "size": "name_length", "encoding": "UTF-8" },
        { "id": "extra", "type": "bytes", "size": "extra_length" },
        { "id": "body", "type": "bytes", "size": "compressed_size" }
      ]
    }
  }
}
